# WebHermes env — copy to .env and fill in. One provider toggle, never hardcoded.
LLM_PROVIDER=opencode
# Your subscription (default provider):
OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Alternatives (Phase 2+):
# OPENROUTER_API_KEY= | OPENROUTER_BASE_URL=https://openrouter.ai/api/v1 | OPENROUTER_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1 | OLLAMA_MODEL=qwen2.5:7b
WEBHERMES_DB=webhermes.db
